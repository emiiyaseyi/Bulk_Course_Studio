<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/bulkcoursestudio/db" VERSION="2026111700" COMMENT="XMLDB file for tool_bulkcoursestudio"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
>
  <TABLES>
    <!-- One row per in-progress or completed course build (wizard or Excel). -->
    <TABLE NAME="tool_bulkcoursestudio_build" COMMENT="A draft or scheduled course build">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Set once committed; null while still draft"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="draft" SEQUENCE="false" COMMENT="draft|scheduled|published"/>
        <FIELD NAME="source" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="wizard" SEQUENCE="false" COMMENT="wizard|excel"/>
        <FIELD NAME="coursedata" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="JSON snapshot of course_edit_form-equivalent fields"/>
        <FIELD NAME="formatoptions" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON: chosen course format + its options"/>
        <FIELD NAME="scheduledtime" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>

    <!-- Draft sections belonging to a build, pre-commit. -->
    <TABLE NAME="tool_bulkcoursestudio_section" COMMENT="A draft section within a build">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="buildid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="summary" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="buildid" TYPE="foreign" FIELDS="buildid" REFTABLE="tool_bulkcoursestudio_build" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <!-- Draft activities belonging to a draft section, pre-commit. -->
    <TABLE NAME="tool_bulkcoursestudio_activity" COMMENT="A draft activity within a draft section">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sectionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="modname" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="e.g. assign, quiz, bulkcoursestudio"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="moduledata" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="JSON snapshot of that module's mod_form fields"/>
        <FIELD NAME="completiondata" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="committedcmid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="course_modules.id once this draft activity has been committed; lets re-committing an edited draft update the same module instead of duplicating it"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="sectionid" TYPE="foreign" FIELDS="sectionid" REFTABLE="tool_bulkcoursestudio_section" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
